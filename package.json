{
  "name": "trillo",
  "version": "1.0.0",
  "description": "an app to help in booking hotels, flights,tours and car rentals",
  "homepage": "https://github.com/darkangel7863/trillo#readme",
  "bugs": {
    "url": "https://github.com/darkangel7863/trillo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darkangel7863/trillo.git"
  },
  "license": "ISC",
  "author": "Mohamed Ismail",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "watch:sass": "sass sass/main.scss css/style.css -w",
    "devserver": "live-server",
    "start": "npm-run-all --parallel watch:sass devserver ",
    "compile:sass": "sass sass/main.scss css/style.comp.css",
    "prefix:css": "postcss --use autoprefixer -b 'last 10 versions' css/style.comp.css -o css/style.prefix.css",
    "compress:css": "sass css/style.prefix.css css/style.css --style=compressed",
    "build:css": "npm-run-all compile:sass prefix:css compress:css"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "postcss-cli": "^11.0.1",
    "sass": "^1.93.3"
  }
}
